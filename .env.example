# Frontend API URL (Vite reads variables prefixed with VITE_)
VITE_API_BASE_URL=http://localhost:4000

# API server settings (copy into an untracked server .env file)
DATABASE_URL=postgres://crestline:change-me@localhost:5432/crestline_dev
PORT=4000
CORS_ORIGINS=http://localhost:5173
NODE_ENV=development
SESSION_TTL_HOURS=24
APP_BASE_URL=http://localhost:5173

# Configure with your transactional email provider; never commit real secrets.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=security@example.com
# Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=base64-encoded-32-byte-key
